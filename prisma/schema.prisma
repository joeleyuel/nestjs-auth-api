generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  roles            String[] @default(["customer"])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
